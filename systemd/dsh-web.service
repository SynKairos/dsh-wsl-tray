[Unit]
Description=DeepSeek Harness Web GUI (dsh web)
Documentation=https://github.com/SynKairos/dsh-wsl-tray
# Owned by the tray: started and stopped from its panel, deliberately NOT
# enabled at boot. linger keeps a user manager alive for as long as the VM
# lives, so `systemctl --user` works from any client without a login session.
# The unit outlives a terminal, but not the VM: the tray's keeper is what holds
# the VM, and it is released when the tray exits.
After=default.target

[Service]
Type=simple
WorkingDirectory=%h
Environment=DSH_WORKSPACE=%h/dsh-workspace
Environment=DSH_PORT=3080
Environment=PATH=%h/.local/node/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/bin/bash -l %h/bin/dsh-serve.sh
# Restart only on failure: a deliberate `systemctl stop` must stay stopped.
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
KillMode=mixed
# Append (never truncate): the tray reads the tail of this file for the token,
# and a restart must not throw away the previous run's log.
StandardOutput=append:%h/.local/state/dsh-web.log
StandardError=append:%h/.local/state/dsh-web.log

[Install]
WantedBy=default.target
